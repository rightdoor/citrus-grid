{
  "name": "citrus-grid",
  "type": "module",
  "version": "1.0.0",
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "astro build && node scripts/inject-modulepreloads.js && node scripts/minify-inline-scripts.js && pagefind --site dist",
    "preview": "astro preview",
    "check": "astro check",
    "type-check": "tsc --noEmit",
    "new-post": "node scripts/new-post.js",
    "format-post-meta": "node scripts/format-post-meta.js",
    "format": "biome format --write ./src",
    "format:all": "biome check --write ./src ./scripts ./astro.config.mjs ./biome.json ./package.json ./tsconfig.json",
    "lint": "biome check --write ./src",
    "preinstall": "npx only-allow pnpm"
  },
  "packageManager": "pnpm@10.30.0",
  "engines": {
    "node": ">=22.14.0"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "^7.2.4",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.3",
    "@swup/astro": "^1.8.0",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "7.2.9",
    "dayjs": "^1.11.23",
    "js-yaml": "^5.4.1",
    "katex": "^0.18.4",
    "lightningcss": "^1.33.0",
    "pagefind": "^1.5.2",
    "photoswipe": "^5.4.4",
    "pinyin-pro": "^3.29.3",
    "prismjs": "^1.30.0",
    "reading-time": "^1.5.0",
    "rehype-autolink-headings": "^7.1.0",
    "rehype-katex": "^7.0.1",
    "rehype-raw": "^7.0.0",
    "rehype-slug": "^6.0.0",
    "rehype-stringify": "^10.0.1",
    "remark-breaks": "^4.0.0",
    "remark-emoji": "^5.0.2",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "unified": "^11.0.5"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@biomejs/biome": "^2.5.10",
    "@types/hast": "^3.0.5",
    "@types/mdast": "^4.0.4",
    "@types/node": "^26.4.0",
    "@types/prismjs": "^1.26.6",
    "@types/unist": "^3.0.3",
    "esbuild": "^0.28.2",
    "sharp": "^0.35.4",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3"
  }
}
