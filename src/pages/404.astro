---
import Icon from '@/components/Icon.astro'
import { defaultLang, localePath, useTranslations } from '@/i18n/ui'
import BaseLayout from '@/layouts/BaseLayout.astro'
import { mdiArrowLeft, mdiHomeOutline } from '@/lib/icons'

const lang = defaultLang
const t = useTranslations(lang)
---

<BaseLayout lang={lang} title="404">
  <div class="flex min-h-[60vh] flex-col items-center justify-center px-4 text-center">
    <h1 class="font-serif text-[6rem] leading-none font-bold text-accent max-md:text-[4.5rem]">404</h1>
    <p class="mt-2 mb-8 text-lg text-ink-2">{t('notFound.message')}</p>
    <div class="flex gap-3">
      <a
        href="javascript:history.length > 1 ? history.back() : void 0"
        class="inline-flex items-center gap-1.5 rounded-[8px] border border-line-light bg-surface px-4 py-2 text-[0.9rem] text-ink-2 shadow-card transition hover:border-accent hover:text-accent"
      >
        <Icon d={mdiArrowLeft} />
        {t('notFound.back')}
      </a>
      <a
        href={localePath(lang, '/')}
        class="inline-flex items-center gap-1.5 rounded-[8px] bg-accent px-4 py-2 text-[0.9rem] text-paper! shadow-card transition hover:bg-accent-hover"
      >
        <Icon d={mdiHomeOutline} />
        {t('notFound.home')}
      </a>
    </div>
  </div>
</BaseLayout>
