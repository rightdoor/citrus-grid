---
import CategoriesPage from '@/components/pages/CategoriesPage.astro'
import { defaultLang, useTranslations } from '@/i18n/ui'
import BaseLayout from '@/layouts/BaseLayout.astro'
import { getPublishedPosts, groupByCategory } from '@/lib/posts'

const lang = defaultLang
const t = useTranslations(lang)
const posts = await getPublishedPosts()
const categories = groupByCategory(posts)
---

<BaseLayout lang={lang} title={t('categories.title')}>
  <CategoriesPage lang={lang} categories={categories} />
</BaseLayout>
