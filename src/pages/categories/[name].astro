---
import ArchivePage from '@/components/pages/ArchivePage.astro'
import { defaultLang, useTranslations } from '@/i18n/ui'
import BaseLayout from '@/layouts/BaseLayout.astro'
import { getPublishedPosts } from '@/lib/posts'

export async function getStaticPaths() {
  const posts = await getPublishedPosts()
  const names = [...new Set(posts.map((p) => p.data.category))]
  return names.map((name) => ({ params: { name }, props: { name } }))
}

const lang = defaultLang
const t = useTranslations(lang)
const { name } = Astro.props
const posts = (await getPublishedPosts()).filter((p) => p.data.category === name)
---

<BaseLayout lang={lang} title={t('pageTitle.category', { name })}>
  <ArchivePage lang={lang} posts={posts} />
</BaseLayout>
