---
import FriendsPage from '@/components/pages/FriendsPage.astro'
import { defaultLang, useTranslations } from '@/i18n/ui'
import BaseLayout from '@/layouts/BaseLayout.astro'
import { getFriendLinks } from '@/lib/friends'

const lang = defaultLang
const t = useTranslations(lang)
const friends = getFriendLinks()
---

<BaseLayout lang={lang} title={t('nav.friends')}>
  <FriendsPage lang={lang} friends={friends} />
</BaseLayout>
