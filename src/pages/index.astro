---
import HomePage from '@/components/pages/HomePage.astro'
import { defaultLang, localePath } from '@/i18n/ui'
import BaseLayout from '@/layouts/BaseLayout.astro'
import { getPublishedPosts } from '@/lib/posts'
import { siteConfig } from '@/site.config'

const lang = defaultLang
const all = await getPublishedPosts()
const perPage = siteConfig.postsPerPage
const totalPages = Math.ceil(all.length / perPage) || 1
const posts = all.slice(0, perPage)
---

<BaseLayout lang={lang}>
  <HomePage
    lang={lang}
    posts={posts}
    currentPage={1}
    totalPages={totalPages}
    baseUrl={localePath(lang, '/')}
  />
</BaseLayout>
