---
import PostPage from '@/components/views/PostPage.astro'
import { defaultLang } from '@/i18n/ui'
import BaseLayout from '@/layouts/BaseLayout.astro'
import { getPublishedPosts, type Post, seriesOf, sortSeriesPosts } from '@/lib/posts'

export async function getStaticPaths() {
  const posts = await getPublishedPosts()
  return posts.map((post: Post, idx: number) => {
    const seriesName = seriesOf(post)
    const seriesPosts = seriesName
      ? sortSeriesPosts(posts.filter((p) => seriesOf(p) === seriesName))
      : []
    const seriesIdx = seriesPosts.findIndex((p) => p.id === post.id)
    return {
      params: { slug: post.id },
      props: {
        post,
        prevPost: idx > 0 ? posts[idx - 1] : null,
        nextPost: idx < posts.length - 1 ? posts[idx + 1] : null,
        seriesPosts,
        seriesIdx,
      },
    }
  })
}

const lang = defaultLang
const { post, prevPost, nextPost, seriesPosts = [], seriesIdx = -1 } = Astro.props
const firstImage = post.body?.match(/!\[[^\]]*\]\(([^)\s]+)/)?.[1]
---

<BaseLayout
  lang={lang}
  title={post.data.title}
  description={post.data.description}
  showTocButton
  seoType="article"
  publishedTime={post.data.published.toISOString()}
  modifiedTime={post.data.updated?.toISOString()}
  seoImage={firstImage}
>
  <PostPage
    lang={lang}
    post={post}
    prevPost={prevPost}
    nextPost={nextPost}
    seriesPosts={seriesPosts}
    seriesIdx={seriesIdx}
  />
</BaseLayout>
