---
import type { GetStaticPathsOptions, Page } from 'astro'
import HomePage from '@/components/pages/HomePage.astro'
import { defaultLang, localePath, useTranslations } from '@/i18n/ui'
import BaseLayout from '@/layouts/BaseLayout.astro'
import { getPublishedPosts, type Post } from '@/lib/posts'
import { siteConfig } from '@/site.config'

export async function getStaticPaths({ paginate }: GetStaticPathsOptions) {
  const posts = await getPublishedPosts()
  return paginate(posts, {
    params: {},
    pageSize: siteConfig.postsPerPage,
  }).filter((p) => Number(p.params.page) > 1)
}

const lang = defaultLang
const t = useTranslations(lang)
const { page } = Astro.props as { page: Page<Post> }
---

<BaseLayout lang={lang} title={t('pagination.pageTitle', { n: page.currentPage })}>
  <HomePage
    lang={lang}
    posts={page.data}
    currentPage={page.currentPage}
    totalPages={page.lastPage}
    baseUrl={localePath(lang, '/')}
  />
</BaseLayout>
