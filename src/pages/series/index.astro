---
import SeriesIndexPage from '@/components/views/SeriesIndexPage.astro'
import { defaultLang, useTranslations } from '@/i18n/ui'
import BaseLayout from '@/layouts/BaseLayout.astro'
import { getPublishedPosts, getSeries } from '@/lib/posts'

const lang = defaultLang
const t = useTranslations(lang)
const seriesList = getSeries(await getPublishedPosts())
---

<BaseLayout lang={lang} title={t('series.title')}>
  <SeriesIndexPage lang={lang} seriesList={seriesList} />
</BaseLayout>