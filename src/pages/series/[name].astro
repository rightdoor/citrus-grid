---
import SeriesDetailPage from '@/components/views/SeriesDetailPage.astro'
import { defaultLang, useTranslations } from '@/i18n/ui'
import BaseLayout from '@/layouts/BaseLayout.astro'
import { getPublishedPosts, getSeries, type Post } from '@/lib/posts'

export async function getStaticPaths() {
  const seriesList = getSeries(await getPublishedPosts())
  return seriesList.map((s) => ({
    params: { name: s.name },
    props: { name: s.name, posts: s.posts as Post[] },
  }))
}

const lang = defaultLang
const t = useTranslations(lang)
const { name, posts } = Astro.props
---

<BaseLayout lang={lang} title={t('pageTitle.series', { name })}>
  <SeriesDetailPage lang={lang} name={name} posts={posts} />
</BaseLayout>