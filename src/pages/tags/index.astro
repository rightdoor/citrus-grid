---
import TagsPage from '@/components/pages/TagsPage.astro'
import { defaultLang, useTranslations } from '@/i18n/ui'
import BaseLayout from '@/layouts/BaseLayout.astro'
import { getPublishedPosts, groupByTags } from '@/lib/posts'

const lang = defaultLang
const t = useTranslations(lang)
const posts = await getPublishedPosts()
const tags = groupByTags(posts)
---

<BaseLayout lang={lang} title={t('tags.title')}>
  <TagsPage lang={lang} tags={tags} />
</BaseLayout>
