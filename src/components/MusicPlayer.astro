---
import '@/styles/music-player.css'
import Icon from '@/components/Icon.astro'
import { defaultLang, type Lang, useTranslations } from '@/i18n/ui'
import {
  mdiClose,
  mdiMusicNote,
  mdiPause,
  mdiPlay,
  mdiPlaylistMusic,
  mdiRepeat,
  mdiRepeatOnce,
  mdiShuffleVariant,
  mdiSkipNext,
  mdiSkipPrevious,
  mdiStop,
  mdiVolumeHigh,
  mdiVolumeMute,
} from '@/lib/icons'
import { discoverPlaylist } from '@/lib/musicPlaylist'
import { siteConfig } from '@/site.config'

interface Props {
  lang?: Lang
}

const { lang = defaultLang } = Astro.props
const t = useTranslations(lang)
const player = siteConfig.musicPlayer
const playlist = player.playlist.length > 0 ? player.playlist : discoverPlaylist()
const ui = {
  title: t('player.title'),
  toggle: t('player.toggle'),
  play: t('player.play'),
  pause: t('player.pause'),
  stop: t('player.stop'),
  prev: t('player.prev'),
  next: t('player.next'),
  shuffle: t('player.shuffle'),
  order: t('player.order'),
  loop: t('player.loop'),
  volume: t('player.volume'),
  playlist: t('player.playlist'),
  empty: t('player.empty'),
}
---

{
  player.enabled && (
    <section class="music-player" data-music-player aria-label={ui.title}>
      <button
        type="button"
        class="scroll-control-btn music-fab"
        data-music-open
        aria-label={ui.toggle}
        aria-expanded="false"
        title={ui.title}
      >
        <span class="music-fab-core">
          <span class="music-fab-icon">
            <Icon d={mdiMusicNote} />
          </span>
          <span class="music-disc-wrap">
            <img class="music-disc" data-music-disc alt="" />
          </span>
        </span>
      </button>

      <div class="music-panel" data-music-panel hidden>
        <div class="music-panel-head">
          <div class="music-panel-head-inner">
            <div class="music-cover" data-music-cover-wrap>
              <img data-music-cover alt="" hidden />
            </div>
            <div class="music-head-right">
              <div class="music-title-row">
                <span class="music-title" data-music-title></span>
                <span class="music-index" data-music-index></span>
              </div>
              <div class="music-vol-row">
                <div class="music-volbar" data-music-volbar role="slider" aria-label={ui.volume}>
                  <div class="music-volbar-fill" data-music-volfill></div>
                  <div class="music-volbar-thumb" data-music-volthumb></div>
                </div>
                <button
                  type="button"
                  class="music-mute-btn"
                  data-music-mute
                  title={ui.volume}
                  aria-label={ui.volume}
                >
                  <span class="music-vol-icon-high">
                    <Icon d={mdiVolumeHigh} />
                  </span>
                  <span class="music-vol-icon-mute">
                    <Icon d={mdiVolumeMute} />
                  </span>
                </button>
              </div>
            </div>
          </div>
        </div>

        <div class="music-progress" data-music-progress role="slider" aria-label={ui.title}>
          <div class="music-progress-fill" data-music-fill></div>
          <div class="music-progress-thumb" data-music-thumb></div>
        </div>
        <div class="music-times">
          <span data-music-current>0:00</span>
          <span data-music-duration>0:00</span>
        </div>

        <div class="music-controls">
          <button type="button" data-music-prev title={ui.prev} aria-label={ui.prev}>
            <Icon d={mdiSkipPrevious} />
          </button>
          <button
            type="button"
            class="music-primary"
            data-music-play
            title={ui.play}
            aria-label={ui.play}
          >
            <span class="music-ic-play">
              <Icon d={mdiPlay} />
            </span>
            <span class="music-ic-pause">
              <Icon d={mdiPause} />
            </span>
          </button>
          <button type="button" data-music-stop title={ui.stop} aria-label={ui.stop}>
            <Icon d={mdiStop} />
          </button>
          <button type="button" data-music-next title={ui.next} aria-label={ui.next}>
            <Icon d={mdiSkipNext} />
          </button>
          <button type="button" data-music-showlist title={ui.playlist} aria-label={ui.playlist}>
            <Icon d={mdiPlaylistMusic} />
          </button>
          <button
            type="button"
            data-music-mode
            title={ui.order}
            aria-label={ui.order}
          >
            <span class="music-mode-ic-order">
              <Icon d={mdiRepeat} />
            </span>
            <span class="music-mode-ic-loop">
              <Icon d={mdiRepeatOnce} />
            </span>
            <span class="music-mode-ic-shuffle">
              <Icon d={mdiShuffleVariant} />
            </span>
          </button>
        </div>
      </div>

      <div class="music-panel music-panel-list" data-music-panel-list hidden>
        <div class="music-panel-list-head">
          <button
            type="button"
            class="music-panel-close"
            data-music-closelist
            title={ui.toggle}
            aria-label={ui.toggle}
          >
            <Icon d={mdiClose} />
          </button>
          <span class="music-panel-list-title">{ui.playlist}</span>
          <span class="music-panel-list-count" data-music-listcount></span>
        </div>
        <div class="music-list-wrap">
          {playlist.length > 0 ? (
            <ul class="music-playlist-list" data-music-list>
              {playlist.map((track, i) => (
                <li data-music-item={i}>
                  <button type="button">{track.title}</button>
                </li>
              ))}
            </ul>
          ) : (
            <div class="music-empty">{ui.empty}</div>
          )}
          <div class="music-scrollbar" data-music-scrollbar>
            <div class="music-scrollbar-thumb" data-music-scrollthumb></div>
          </div>
        </div>
      </div>

      <audio data-music-audio preload="metadata" playsinline></audio>

      <script is:inline define:vars={{ playlist, ui }}>
        window.__musicPlayerConfig = { playlist }
        window.__musicPlayerUI = ui
      </script>

      <script>
        import { extractAudioCover } from '@/lib/audioCover'
        import { clampRatio, createPlayer, formatTime, type PlayerTrack } from '@/lib/player'
        import {
          bindAudioEvents,
          bindProgressDrag,
          bindVolumeDrag,
          createLayoutController,
          createMediaPort,
          createPanelController,
          createPlayerViewFrom,
          createScrollbarController,
          queryPlayerElements,
        } from '@/lib/musicUi'

        const cfg = (window as any).__musicPlayerConfig as { playlist: PlayerTrack[] }
        const uiText = (window as any).__musicPlayerUI as Record<string, string>
        const tracks = cfg.playlist

        const els = queryPlayerElements()
        if (els) {
          const {
            root,
            audio,
            fab,
            panel,
            panelList,
            disc,
            cover,
            title: titleEl,
            index: indexEl,
            progress,
            time: timeEl,
            duration: durEl,
            listCount: listCountEl,
            list: listEl,
            scrollbar: scrollbarEl,
            scrollThumb,
            prev: prevBtn,
            play: playBtn,
            stop: stopBtn,
            next: nextBtn,
          } = els

          const view = createPlayerViewFrom(els, uiText)
          const scrollbar = createScrollbarController(listEl, scrollbarEl, scrollThumb)
          const panelUi = createPanelController({
            root,
            fab,
            panel,
            panelList,
            list: listEl,
            scrollbar,
          })
          const layout = createLayoutController(fab, panel, panelList)

          const player = createPlayer(tracks, createMediaPort(audio), {
            onTrack(track, i) {
              titleEl.textContent = track.title
              indexEl.textContent = `${i + 1}/${tracks.length}`
              timeEl.textContent = '0:00'
              durEl.textContent = '0:00'
              view.setFill(0)
              view.applyCover(track.cover)
              extractAudioCover(track.src).then((res) => {
                if (player.state.index !== i || !res) return
                player.setHasCover(true)
                view.applyCover(res.blobUrl)
              })
            },
            onState: view.onState,
          })

          const isSeeking = bindProgressDrag(progress, (ratio) => {
            if (player.state.index < 0 && tracks.length === 0) return
            const seeked = player.seekToRatio(clampRatio(ratio))
            view.setFill(ratio)
            if (seeked !== null) timeEl.textContent = formatTime(seeked)
          })
          bindVolumeDrag(els.volBar, (ratio) => player.setVolume(ratio))

          bindAudioEvents(
            audio,
            player,
            {
              setFill: view.setFill,
              setTimeText: (t) => {
                timeEl.textContent = t
              },
              setDurationText: (t) => {
                durEl.textContent = t
              },
            },
            isSeeking,
          )

          disc.addEventListener('error', () => {
            if (!player.state.hasCover) return
            player.setHasCover(false)
            view.applyCover(undefined)
          })
          cover.addEventListener('error', () => {
            cover.hidden = true
            cover.removeAttribute('src')
          })

          if (listEl) {
            listEl.addEventListener('click', (e) => {
              const li = (e.target as HTMLElement).closest<HTMLElement>('[data-music-item]')
              if (!li || !li.dataset.musicItem) return
              player.load(Number(li.dataset.musicItem), true)
            })
          }
          if (tracks.length > 0) listCountEl.textContent = String(tracks.length)
          playBtn.addEventListener('click', () => player.togglePlay())
          prevBtn.addEventListener('click', () => player.prev())
          nextBtn.addEventListener('click', () => player.next())
          stopBtn.addEventListener('click', () => player.stop())
          els.mute.addEventListener('click', () => player.toggleMute())
          els.mode.addEventListener('click', () => player.cycleMode())

          fab.addEventListener('click', () => panelUi.setExpanded(!panelUi.isExpanded()))
          els.showList.addEventListener('click', () => panelUi.setListOpen(true))
          els.closeList.addEventListener('click', () => panelUi.closeTopmost())
          document.addEventListener('pointerdown', (e) => {
            if (panelUi.isExpanded() && !root.contains(e.target as Node)) panelUi.setExpanded(false)
          })
          document.addEventListener('keydown', (e) => {
            if (e.key === 'Escape') panelUi.closeTopmost()
          })

          scrollbar.bindThumbDrag()
          layout.reposition()
          document.addEventListener('astro:page-load', layout.reposition)
          window.addEventListener('resize', layout.reposition)
          player.setVolume(player.state.volume)
        }
      </script>
    </section>
  )
}
