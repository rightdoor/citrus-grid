---
import Icon from '@/components/Icon.astro'
import { defaultLang, type Lang, localePath, useTranslations } from '@/i18n/ui'
import { mdiLayers } from '@/lib/icons'
import { monthDay, type Post } from '@/lib/posts'

interface Props {
  lang?: Lang
  name: string
  posts: Post[]
}

const { lang = defaultLang, name, posts } = Astro.props
const t = useTranslations(lang)
const postUrl = (p: Post) => localePath(lang, `/posts/${p.id}`)
---

<div class="mx-auto mt-8 max-w-[800px]">
  <header class="mb-8 text-center">
    <h1 class="inline-flex items-center gap-2 font-serif text-[1.75rem] font-bold text-ink">
      <Icon d={mdiLayers} class="text-2xl text-accent" />
      {name}
    </h1>
    <p class="mt-1 text-sm text-ink-3">
      {posts.length} {t('series.postsUnit')} · {t('series.subtitle')}
    </p>
  </header>

  <div class="flex flex-col">
    {posts.map((p, i) => (
      <a
        href={postUrl(p)}
        class="group flex cursor-pointer items-baseline gap-4 rounded-[6px] px-2 py-2.5 transition hover:bg-surface-hover"
      >
        <span class="w-8 shrink-0 text-right text-[0.85rem] tabular-nums text-accent">{i + 1}</span>
        <span class="min-w-0 flex-1 truncate text-ink transition group-hover:text-accent">{p.data.title}</span>
        <span class="hidden shrink-0 text-xs tabular-nums text-ink-3 md:block">{monthDay(p.data.published)}</span>
      </a>
    ))}
  </div>
</div>