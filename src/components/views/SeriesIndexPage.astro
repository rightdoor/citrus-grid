---
import Icon from '@/components/Icon.astro'
import { defaultLang, type Lang, localePath, useTranslations } from '@/i18n/ui'
import { mdiLayers } from '@/lib/icons'
import type { SeriesItem } from '@/lib/posts'

interface Props {
  lang?: Lang
  seriesList: SeriesItem[]
}

const { lang = defaultLang, seriesList } = Astro.props
const t = useTranslations(lang)
---

<div class="mx-auto mt-8 max-w-[800px]">
  <header class="mb-8 text-center">
    <h1 class="font-serif text-[1.75rem] font-bold text-ink">{t('series.title')}</h1>
    <p class="mt-1 text-sm text-ink-3">{t('series.subtitle')}</p>
  </header>

  {
    seriesList.length === 0 ? (
      <div class="mt-16 text-center text-[0.95rem] text-ink-3">{t('series.empty')}</div>
    ) : (
      <div class="flex flex-col">
        {seriesList.map((s) => (
          <a
            href={localePath(lang, `/series/${encodeURIComponent(s.name)}`)}
            class="group flex cursor-pointer items-center justify-between rounded-[6px] px-2 py-3 transition hover:bg-surface-hover"
          >
            <span class="inline-flex min-w-0 items-center gap-2 text-base text-ink! transition group-hover:text-accent">
              <Icon d={mdiLayers} class="shrink-0 text-lg text-ink-3" />
              <span class="truncate">{s.name}</span>
            </span>
            <span class="shrink-0 rounded-[3px] bg-paper px-2 py-0.5 text-xs tabular-nums text-ink-3">
              {s.posts.length} {t('series.postsUnit')}
            </span>
          </a>
        ))}
      </div>
    )
  }
</div>