---
import Icon from '@/components/Icon.astro'
import { defaultLang, type Lang, localePath, useTranslations } from '@/i18n/ui'
import { mdiCloseCircle, mdiFolderOutline, mdiMagnify, mdiTagOutline } from '@/lib/icons'
import type { NameCount } from '@/lib/posts'

type TaxonomyKind = 'categories' | 'tags'

interface Props {
  lang?: Lang
  kind: TaxonomyKind
  items: NameCount[]
}

const { lang = defaultLang, kind, items } = Astro.props
const t = useTranslations(lang)
const isCategory = kind === 'categories'

const rootId = isCategory ? 'categories' : 'tags'
const searchId = isCategory ? 'category-search' : 'tag-search'
const clearId = isCategory ? 'category-clear' : 'tag-clear'
const emptyId = isCategory ? 'categories-empty' : 'tags-empty'
const totalId = isCategory ? 'categories-total' : 'tags-total'
const totalClass = isCategory
  ? 'mt-6 text-center text-sm text-ink-3'
  : 'mt-8 text-center text-sm text-ink-3'
const detailPath = (name: string) =>
  localePath(lang, `${isCategory ? '/categories/' : '/tags/'}${encodeURIComponent(name)}`)
---

<div class="mx-auto max-w-[800px] mt-8" id={rootId}>
  <header class="mb-8 text-center">
    <h1 class="font-serif text-[1.75rem] font-bold text-ink">
      {isCategory ? t('categories.title') : t('tags.title')}
    </h1>
    <p class="mt-1 text-sm text-ink-3">
      {isCategory ? t('categories.subtitle') : t('tags.subtitle')}
    </p>
  </header>

  <div class="mb-6 flex items-center gap-3">
    <div class="flex flex-1 items-center gap-2 rounded-[8px] border border-line-light bg-paper px-3 py-2 transition focus-within:border-accent">
      <Icon d={mdiMagnify} class="text-ink-3" />
      <input
        type="text"
        id={searchId}
        placeholder={isCategory ? t('categories.searchPlaceholder') : t('tags.searchPlaceholder')}
        class="w-full bg-transparent text-sm text-ink outline-none placeholder:text-ink-3"
      />
      <button
        id={clearId}
        type="button"
        class="hidden cursor-pointer text-ink-3 transition hover:text-ink"
        aria-label={t('misc.clear')}
        title={t('misc.clear')}
      >
        <Icon d={mdiCloseCircle} class="text-sm" />
      </button>
    </div>
    <div class="flex items-center gap-1">
      <button
        type="button"
        class="sort-btn rounded-[6px] bg-paper px-2.5 py-1 text-sm transition"
        data-sort="name"
        title={t('misc.sortByName')}
      >
        A
      </button>
      <button
        type="button"
        class="sort-btn rounded-[6px] bg-paper px-2.5 py-1 text-sm transition"
        data-sort="count"
        title={t('misc.sortByCount')}
      >
        #
      </button>
    </div>
  </div>

  {
    isCategory ? (
      items.length === 0 ? (
        <div class="mt-16 text-center text-[0.95rem] text-ink-3">{t('categories.empty')}</div>
      ) : (
        <div class="flex flex-col" id="category-list">
          {items.map((c) => (
            <a
              href={detailPath(c.name)}
              class="category-row group flex cursor-pointer items-center justify-between rounded-[6px] px-2 py-3 text-ink! transition hover:bg-surface-hover"
              data-name={c.name}
              data-count={c.count}
            >
              <span class="inline-flex items-center gap-2 text-base transition group-hover:text-accent">
                <Icon d={mdiFolderOutline} class="text-lg text-ink-3" />
                {c.name}
              </span>
              <span class="rounded-[3px] bg-paper px-2 py-0.5 text-xs text-ink-3">{c.count}</span>
            </a>
          ))}
        </div>
      )
    ) : items.length === 0 ? (
      <div class="mt-16 text-center text-[0.95rem] text-ink-3">{t('tags.empty')}</div>
    ) : (
      <div class="mt-4 flex flex-wrap justify-center gap-2.5" id="tag-list">
        {items.map((item) => (
          <a
            href={detailPath(item.name)}
            class="tag-row inline-flex items-center gap-1.5 rounded-[8px] border border-line-light bg-surface px-3 py-1.5 text-[0.9rem] text-ink! shadow-card transition hover:-translate-y-px hover:border-accent hover:text-accent! hover:shadow-card-hover"
            data-name={item.name}
            data-count={item.count}
          >
            <Icon d={mdiTagOutline} class="text-sm" />
            {item.name}
            <span class="min-w-[1.4em] rounded-[3px] bg-paper px-1 py-0.5 text-center text-[0.75rem] text-ink-3">
              {item.count}
            </span>
          </a>
        ))}
      </div>
    )
  }

  <div id={emptyId} class="mt-16 hidden text-center text-[0.95rem] text-ink-3">
    {isCategory ? t('categories.empty') : t('tags.empty')}
  </div>

  {
    items.length > 0 && (
      <div
        id={totalId}
        class={totalClass}
        data-template={isCategory ? t('categories.total') : t('tags.total')}
      >
        {isCategory ? t('categories.total', { n: items.length }) : t('tags.total', { n: items.length })}
      </div>
    )
  }
</div>

<script>
  import { onPageLoad } from '@/lib/pageLifecycle'
  import { categoriesSort, tagsSort } from '@/stores/ui'

  function initTaxonomyPage() {
    const root = document.querySelector<HTMLElement>('#categories, #tags')
    if (!root) return
    const isCategory = root.id === 'categories'
    const prefix = isCategory ? 'category' : 'tag'
    const plural = isCategory ? 'categories' : 'tags'
    const sortStore = isCategory ? categoriesSort : tagsSort

    const searchInput = root.querySelector<HTMLInputElement>(`#${prefix}-search`)
    const clearBtn = root.querySelector<HTMLButtonElement>(`#${prefix}-clear`)
    const list = root.querySelector<HTMLElement>(`#${prefix}-list`)
    const rows = Array.from(list?.querySelectorAll<HTMLElement>(`.${prefix}-row`) ?? [])
    const sortBtns = Array.from(root.querySelectorAll<HTMLButtonElement>('.sort-btn'))
    const emptyEl = root.querySelector<HTMLElement>(`#${plural}-empty`)
    const totalEl = root.querySelector<HTMLElement>(`#${plural}-total`)

    let sortBy: 'name' | 'count' = sortStore.get()

    function render() {
      if (!list) return
      const q = (searchInput?.value || '').trim().toLowerCase()
      const filtered = rows.filter((r) => (r.dataset.name || '').toLowerCase().includes(q))
      const sorted = [...filtered].sort((a, b) => {
        if (sortBy === 'name') {
          return (a.dataset.name || '').localeCompare(b.dataset.name || '', 'zh')
        }
        return Number(b.dataset.count || 0) - Number(a.dataset.count || 0)
      })
      for (const row of rows) row.style.display = 'none'
      for (const row of sorted) {
        row.style.display = ''
        list.appendChild(row)
      }
      clearBtn?.classList.toggle('hidden', !q)
      if (emptyEl) emptyEl.classList.toggle('hidden', filtered.length > 0)
      if (totalEl) {
        totalEl.textContent = (totalEl.dataset.template || '').replace('{n}', String(filtered.length))
      }
      for (const btn of sortBtns) {
        const active = btn.dataset.sort === sortBy
        btn.classList.toggle('bg-accent', active)
        btn.classList.toggle('bg-paper', !active)
        btn.classList.toggle('text-white', active)
        btn.classList.toggle('text-ink-3', !active)
        btn.classList.toggle('hover:bg-surface-hover', !active)
        btn.classList.toggle('hover:text-ink', !active)
      }
    }

    searchInput?.addEventListener('input', render)
    clearBtn?.addEventListener('click', () => {
      if (!searchInput) return
      searchInput.value = ''
      render()
      searchInput.focus()
    })
    for (const btn of sortBtns) {
      btn.addEventListener('click', () => {
        sortBy = (btn.dataset.sort as 'name' | 'count') || 'count'
        sortStore.set(sortBy)
        render()
      })
    }
    render()
  }
  onPageLoad(initTaxonomyPage)
</script>
