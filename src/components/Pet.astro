---
import '@/styles/Pet.css'
import { defaultLang, type Lang, useTranslations } from '@/i18n/ui'
import { siteConfig } from '@/site.config'

interface Props {
  lang?: Lang
}

const { lang = defaultLang } = Astro.props
const t = useTranslations(lang)
const petEnabled = siteConfig.pet?.enabled === true
---

{
  petEnabled && (
    <>
      <script is:inline data-swup-ignore-script>
        ;(function () {
          try {
            var until = Number(localStorage.getItem('petClosedUntil') || 0)
            var html = document.documentElement
            if (until > Date.now()) {
              html.classList.add('pet-off')
              return
            }
            if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return
            html.classList.add('pet-assembling')
            setTimeout(function () {
              if (document.querySelector('[data-pet][data-pet-ready]')) return
              html.classList.remove('pet-assembling')
            }, 2000)
          } catch {}
        })()
      </script>
      <div class="pet" data-pet>
        <div class="pet-face" data-pet-face aria-hidden="true">
          <div class="pet-slide" data-pet-slide>
            <div class="pet-eyes" data-pet-eyes>
              <span class="pet-eye" data-pet-eye />
              <span class="pet-eye" data-pet-eye />
            </div>
          </div>
        </div>
        <div class="pet-card" data-pet-card role="dialog" aria-label={t('pet.dialogLabel')} hidden>
          <p class="pet-card-title">{t('pet.title')}</p>
          <p class="pet-card-desc">{t('pet.desc')}</p>
          <div class="pet-card-actions">
            <button class="pet-btn pet-btn-ok" type="button" data-pet-dismiss>
              {t('pet.confirm')}
            </button>
          </div>
        </div>
      </div>
    </>
  )
}