---
import { defaultLang, type Lang, localePath, useTranslations } from '@/i18n/ui'
import type { Post } from '@/lib/posts'

interface Props {
  lang?: Lang
  prev?: Post | null
  next?: Post | null
}

const { lang = defaultLang, prev = null, next = null } = Astro.props
const t = useTranslations(lang)
const postUrl = (p: Post) => localePath(lang, `/posts/${p.id}`)
---

<nav class="flex justify-between gap-4 max-md:flex-col">
  {
    prev ? (
      <a
        href={postUrl(prev)}
        class="min-w-0 flex-1 truncate rounded-[8px] border border-line-light bg-surface px-4 py-3 text-left text-[0.9rem] text-ink-2 transition hover:border-accent hover:text-accent max-md:max-w-full"
      >
        <span class="mb-0.5 block text-[0.78rem] text-ink-3">{t('post.prev')}</span>
        <span class="block truncate">{prev.data.title}</span>
      </a>
    ) : (
      <span class="min-w-0 flex-1 cursor-not-allowed rounded-[8px] border border-line-light bg-surface px-4 py-3 text-left text-[0.9rem] text-ink-2 opacity-40 max-md:max-w-full">
        <span class="mb-0.5 block text-[0.78rem] text-ink-3">{t('post.prev')}</span>
        <span class="block truncate">{t('post.noMore')}</span>
      </span>
    )
  }
  {
    next ? (
      <a
        href={postUrl(next)}
        class="min-w-0 flex-1 truncate rounded-[8px] border border-line-light bg-surface px-4 py-3 text-right text-[0.9rem] text-ink-2 transition hover:border-accent hover:text-accent max-md:max-w-full"
      >
        <span class="mb-0.5 block text-[0.78rem] text-ink-3">{t('post.next')}</span>
        <span class="block truncate">{next.data.title}</span>
      </a>
    ) : (
      <span class="min-w-0 flex-1 cursor-not-allowed rounded-[8px] border border-line-light bg-surface px-4 py-3 text-right text-[0.9rem] text-ink-2 opacity-40 max-md:max-w-full">
        <span class="mb-0.5 block text-[0.78rem] text-ink-3">{t('post.next')}</span>
        <span class="block truncate">{t('post.noMore')}</span>
      </span>
    )
  }
</nav>
