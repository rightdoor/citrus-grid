---
import Icon from '@/components/Icon.astro'
import { defaultLang, type Lang, useTranslations } from '@/i18n/ui'
import { mdiClose, mdiCloseCircle, mdiMagnify } from '@/lib/icons'

interface Props {
  lang?: Lang
}

const { lang = defaultLang } = Astro.props
const t = useTranslations(lang)
---

<div id="search-modal" class="wp-overlay fixed inset-0 z-[1500] hidden items-center justify-center bg-black/40 p-4">
  <div class="wp-modal-panel flex max-h-[85vh] w-full flex-col rounded-[8px] border border-line-light bg-surface shadow-card" style="max-width: 520px">
    <div class="flex items-center justify-between border-b border-line-light px-5 py-3.5">
      <h3 class="font-bold text-ink">{t('search.title')}</h3>
      <button id="search-close" class="rounded p-1 text-ink-3 transition hover:bg-surface-hover hover:text-ink" type="button">
        <Icon d={mdiClose} class="text-lg" />
      </button>
    </div>
    <div class="min-h-0 flex-1 overflow-y-auto px-5 py-4">
      <div class="flex items-center gap-2 rounded-[8px] border border-line-light bg-paper px-3 py-2 transition focus-within:border-accent">
        <Icon d={mdiMagnify} class="text-ink-3" />
        <input
          id="search-input"
          type="text"
          placeholder={t('search.placeholder')}
          class="w-full bg-transparent text-sm text-ink outline-none placeholder:text-ink-3"
        />
        <button id="search-clear" type="button" class="hidden text-ink-3 hover:text-ink">
          <Icon d={mdiCloseCircle} class="text-sm" />
        </button>
      </div>

      <div id="search-failed" class="hidden py-6 text-center text-sm text-ink-3">{t('search.failed')}</div>
      <div id="search-results" class="mt-4 hidden flex-col gap-2"></div>
      <div id="search-empty" class="hidden py-6 text-center text-sm text-ink-3">{t('search.empty')}</div>
      <div id="search-hint" class="mt-4 text-sm text-ink-3">{t('search.hint')}</div>
    </div>
  </div>
</div>

<script>
  const modal = document.getElementById('search-modal')!
  const input = document.getElementById('search-input') as HTMLInputElement
  const resultsEl = document.getElementById('search-results')!
  const emptyEl = document.getElementById('search-empty')!
  const failedEl = document.getElementById('search-failed')!
  const hintEl = document.getElementById('search-hint')!
  const clearBtn = document.getElementById('search-clear')!

  let pagefind: any = null
  let searchSeq = 0

  function escapeHtml(value: string) {
    return value.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;')
  }

  async function loadPagefind() {
    if (pagefind) return pagefind
    try {
      const pagefindUrl = '/pagefind/pagefind.js'
      pagefind = await import(/* @vite-ignore */ pagefindUrl)
    } catch {
      failedEl.classList.remove('hidden')
    }
    return pagefind
  }

  function renderResults(list: any[]) {
    resultsEl.innerHTML = list
      .map(
        (item) => `
        <button type="button" data-href="${escapeHtml(item.url)}"
          class="rounded-[8px] border border-line-light bg-surface px-4 py-3 text-left transition hover:border-accent">
          <div class="font-serif font-bold text-ink">${escapeHtml(item.meta?.title || item.url)}</div>
          <div class="mt-1 text-xs text-ink-3">${item.excerpt}</div>
        </button>`,
      )
      .join('')
    resultsEl.classList.toggle('hidden', list.length === 0)
    resultsEl.classList.toggle('flex', list.length > 0)
  }

  function updateChrome() {
    const q = input.value.trim()
    clearBtn.classList.toggle('hidden', !input.value)
    hintEl.classList.toggle('hidden', !!q)
    if (!q) {
      emptyEl.classList.add('hidden')
      renderResults([])
    }
  }

  async function runSearch() {
    updateChrome()
    const q = input.value.trim()
    if (!q) return
    const seq = ++searchSeq
    const pf = await loadPagefind()
    if (!pf || seq !== searchSeq) return
    try {
      const res = await pf.search(q)
      const data = await Promise.all(res.results.slice(0, 20).map((r: any) => r.data()))
      if (seq !== searchSeq) return
      renderResults(data)
      emptyEl.classList.toggle('hidden', data.length > 0)
    } catch {
      if (seq === searchSeq) emptyEl.classList.remove('hidden')
    }
  }

  function open() {
    modal.classList.remove('hidden')
    modal.classList.add('flex')
    input.value = ''
    failedEl.classList.add('hidden')
    updateChrome()
    input.focus()
    loadPagefind()
  }

  function close() {
    modal.classList.add('hidden')
    modal.classList.remove('flex')
  }

  function go(url: string) {
    close()
    const swup = (window as any).swup
    if (swup?.navigate) {
      swup.navigate(url)
    } else {
      window.location.assign(url)
    }
  }

  document.addEventListener('open-search', open)
  document.addEventListener('astro:after-swap', close)
  document.addEventListener('keydown', (e: KeyboardEvent) => {
    if (e.key === 'Escape') close()
  })
  document.getElementById('search-close')!.addEventListener('click', close)
  modal.addEventListener('click', (e) => {
    if (e.target === modal) close()
  })
  input.addEventListener('input', runSearch)
  clearBtn.addEventListener('click', () => {
    input.value = ''
    runSearch()
    input.focus()
  })
  resultsEl.addEventListener('click', (e) => {
    const btn = (e.target as HTMLElement)?.closest<HTMLButtonElement>('button[data-href]')
    if (!btn) return
    go(btn.dataset.href!)
  })
</script>
