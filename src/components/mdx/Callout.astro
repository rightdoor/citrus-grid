---
interface Props {
  title?: string
  type?: 'info' | 'tip' | 'warning' | 'danger'
}

const { title = '提示', type = 'info' } = Astro.props
---

<aside class:list={['mdx-callout', `mdx-callout-${type}`]}>
  <p class="mdx-callout-title">{title}</p>
  <div class="mdx-callout-body">
    <slot />
  </div>
</aside>

<style>
  .mdx-callout {
    margin: 1.5em 0;
    padding: 1em 1.25em;
    border-radius: var(--radius-wp);
    border: 1px solid var(--wp-border-light);
    border-left-width: 3px;
    background: var(--wp-surface);
    font-size: 0.98rem;
  }
  .mdx-callout-title {
    font-weight: 700;
    margin-bottom: 0.5em;
    display: flex;
    align-items: center;
    gap: 0.4em;
    color: var(--wp-text);
  }
  .mdx-callout-body > :last-child {
    margin-bottom: 0;
  }
  .mdx-callout-info {
    border-left-color: #6fa8dc;
  }
  .mdx-callout-info .mdx-callout-title {
    color: var(--wp-info-title);
  }
  .mdx-callout-tip {
    border-left-color: #7ba05b;
  }
  .mdx-callout-tip .mdx-callout-title {
    color: var(--wp-tip-title);
  }
  .mdx-callout-warning {
    border-left-color: #d9a441;
  }
  .mdx-callout-warning .mdx-callout-title {
    color: var(--wp-warn-title);
  }
  .mdx-callout-danger {
    border-left-color: #c96a5b;
  }
  .mdx-callout-danger .mdx-callout-title {
    color: var(--wp-danger-title);
  }
</style>
