---
import Icon from '@/components/Icon.astro'
import { defaultLang, type Lang, localePath, useTranslations } from '@/i18n/ui'
import { mdiChevronDown, mdiLayers } from '@/lib/icons'
import type { Post } from '@/lib/posts'

interface Props {
  lang?: Lang
  seriesPosts: Post[]
  postId: string
}

const { lang = defaultLang, seriesPosts, postId } = Astro.props
const t = useTranslations(lang)
const postUrl = (p: Post) => localePath(lang, `/posts/${p.id}`)
---

<section
  id="series-directory"
  class="series-directory mx-auto mb-8 max-w-[800px] rounded-[8px] border border-line-light bg-surface shadow-card"
>
  <button
    type="button"
    id="series-toggle"
    class="flex w-full cursor-pointer items-center justify-between gap-x-3 gap-y-1 p-4 text-left"
    aria-expanded="false"
    aria-controls="series-directory-content"
  >
    <span class="flex min-w-0 items-center gap-2 text-[0.9rem] font-semibold text-ink">
      <Icon d={mdiLayers} class="shrink-0 text-lg text-accent" />
      <span>{t('series.directory')}</span>
    </span>
    <Icon d={mdiChevronDown} class="series-chevron shrink-0 text-base text-ink-3" />
  </button>
  <div id="series-directory-content" class="series-panel">
    <div class="series-content-inner">
      <div class="px-4 pb-4">
        <ul class="series-list flex list-none flex-col gap-0.5 p-0">
          {
            seriesPosts.map((p, i) => (
              <li>
                <a
                  href={postUrl(p)}
                  aria-current={p.id === postId ? 'page' : undefined}
                  class={`flex items-center gap-3 rounded-[6px] px-2 py-1.5 text-[0.88rem] transition ${
                    p.id === postId
                      ? 'border-l-2 border-accent bg-accent/10 text-ink dark:border-l-0 dark:text-accent'
                      : 'text-ink-2 hover:bg-surface-hover hover:text-accent'
                  }`}
                >
                  <span class="w-6 shrink-0 text-right text-[0.78rem] tabular-nums text-ink-3">{i + 1}</span>
                  <span class="min-w-0 flex-1 truncate">{p.data.title}</span>
                  {p.id === postId && (
                    <span class="shrink-0 text-[0.72rem] font-medium text-accent">{t('series.current')}</span>
                  )}
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </div>
</section>

<script>
  const seriesToggle = document.getElementById('series-toggle')
  if (seriesToggle && !seriesToggle.dataset.bound) {
    seriesToggle.dataset.bound = '1'
    seriesToggle.addEventListener('click', () => {
      const root = document.getElementById('series-directory')
      const open = seriesToggle.getAttribute('aria-expanded') === 'true'
      seriesToggle.setAttribute('aria-expanded', String(!open))
      root?.classList.toggle('is-open', !open)
    })
  }
</script>
