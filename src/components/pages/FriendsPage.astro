---
import '@/styles/FriendsPage.css'
import Icon from '@/components/Icon.astro'
import Utterances from '@/components/Utterances.astro'
import { defaultLang, type Lang, useTranslations } from '@/i18n/ui'
import type { FriendLink } from '@/lib/friends'
import { mdiLinkVariant } from '@/lib/icons'

interface Props {
  lang?: Lang
  friends: FriendLink[]
}

const { lang = defaultLang, friends } = Astro.props
const t = useTranslations(lang)

const cards = friends.map((f) => {
  let host = f.url
  try {
    host = new URL(f.url).hostname.replace(/^www\./, '')
  } catch {}
  const name = f.name || host
  return {
    ...f,
    name,
    desc: f.desc || host,
    initial: (name.trim()[0] || '?').toUpperCase(),
  }
})
---

<div class="mx-auto mt-8 max-w-[800px]">
  <header class="mb-10 text-center">
    <h1 class="font-serif text-[1.75rem] font-bold text-ink">{t('nav.friends')}</h1>
    <p class="mt-3 text-[0.9rem] leading-relaxed text-ink-2">
      {t('friends.subtitle')}
    </p>
  </header>

  {
    cards.length === 0 ? (
      <div class="friend-empty">
        <svg viewBox="0 0 120 120" class="friend-sad" aria-hidden="true">
          <circle cx="60" cy="62" r="33" fill="none" stroke="var(--wp-accent)" stroke-width="3.5" stroke-linecap="round" opacity="0.85" />
          <ellipse cx="45" cy="70" rx="5" ry="2.8" fill="var(--wp-accent)" opacity="0.16" />
          <ellipse cx="75" cy="70" rx="5" ry="2.8" fill="var(--wp-accent)" opacity="0.16" />
          <g class="friend-eyes">
            <circle cx="48" cy="56" r="3.4" fill="var(--wp-text-secondary)" />
            <circle cx="72" cy="56" r="3.4" fill="var(--wp-text-secondary)" />
          </g>
          <path d="M49 78 Q60 70 71 78" fill="none" stroke="var(--wp-text-secondary)" stroke-width="3.5" stroke-linecap="round" />
          <path class="friend-tear" d="M75.5 61 c0 0 -4.5 5.5 -4.5 8.5 a4.5 4.5 0 0 0 9 0 c0 -3 -4.5 -8.5 -4.5 -8.5 z" fill="var(--wp-safe-blue)" />
        </svg>
        <p class="friend-empty-title">{t('friends.emptyTitle')}</p>
        <p class="friend-empty-sub" set:html={t('friends.emptySub', { config: '<code>src/config.yaml</code>' })} />
      </div>
    ) : (
      <div class="grid gap-4 sm:grid-cols-2">
        {cards.map((f, i) => (
          <a
            href={f.url}
            target="_blank"
            rel="noopener noreferrer"
            class="friend-card"
            style={`--stagger: ${Math.min(i, 8) * 60}ms`}
          >
            <span class="friend-avatar">
              <span class="friend-avatar-fallback" aria-hidden="true">{f.initial}</span>
              {f.icon && (
                <img
                  src={f.icon}
                  alt=""
                  width="44"
                  height="44"
                  loading="lazy"
                  decoding="async"
                  onerror="this.remove()"
                />
              )}
            </span>
            <span class="min-w-0 flex-1">
              <span class="friend-name">{f.name}</span>
              <span class="friend-desc">{f.desc}</span>
            </span>
            <Icon d={mdiLinkVariant} class="friend-go" />
          </a>
        ))}
      </div>
    )
  }
</div>

<Utterances />

