---
import Icon from '@/components/Icon.astro'
import { defaultLang, type Lang, localePath, useTranslations } from '@/i18n/ui'
import { mdiFolderOutline, mdiTagOutline } from '@/lib/icons'
import { groupByYear, monthDay, type Post } from '@/lib/posts'

interface Props {
  lang?: Lang
  posts: Post[]
}

const { lang = defaultLang, posts } = Astro.props
const t = useTranslations(lang)
const grouped = groupByYear(posts)
const postUrl = (p: Post) => localePath(lang, `/posts/${p.id}`)
---

<div class="mx-auto max-w-[800px] mt-8">
  <header class="mb-8 text-center">
    <h1 class="font-serif text-[1.75rem] font-bold text-ink">{t('archive.title')}</h1>
    <p class="mt-1 text-sm text-ink-3">{t('archive.subtitle')}</p>
  </header>

  {
    grouped.length === 0 ? (
      <div class="mt-16 text-center text-[0.95rem] text-ink-3">{t('list.empty')}</div>
    ) : (
      grouped.map((group) => (
        <section class="mb-2">
          <div class="mb-2 border-b border-line-light pb-2 text-[1.1rem] font-semibold text-ink-2">
            {group.year}
            <span class="ml-2 text-xs font-normal text-ink-3">
              {group.items.length}
              {t('list.postsUnit')}
            </span>
          </div>
          <div class="flex flex-col">
            {group.items.map((post) => (
              <a
                href={postUrl(post)}
                class="group flex cursor-pointer items-baseline gap-4 rounded-[6px] px-2 py-2 transition hover:bg-surface-hover"
              >
                <span class="shrink-0 text-[0.85rem] tabular-nums text-ink-3">{monthDay(post.data.published)}</span>
                <span class="min-w-0 flex-1 truncate text-ink transition group-hover:text-accent">
                  {post.data.title}
                </span>
                <span class="hidden shrink-0 items-center gap-2 text-xs text-ink-3 md:flex">
                  <span class="inline-flex items-center gap-0.5">
                    <Icon d={mdiFolderOutline} class="text-sm" />
                    {post.data.category}
                  </span>
                  {post.data.tags.length > 0 && (
                    <span class="inline-flex items-center gap-0.5">
                      <Icon d={mdiTagOutline} class="text-sm" />
                      {post.data.tags[0]}
                    </span>
                  )}
                </span>
              </a>
            ))}
          </div>
        </section>
      ))
    )
  }
</div>
