---
import Pagination from '@/components/Pagination.astro'
import PostCard from '@/components/PostCard.astro'
import ProfileCard from '@/components/ProfileCard.astro'
import { defaultLang, type Lang, useTranslations } from '@/i18n/ui'
import type { Post } from '@/lib/posts'

interface Props {
  lang?: Lang
  posts: Post[]
  currentPage: number
  totalPages: number
  baseUrl: string
}

const { lang = defaultLang, posts, currentPage, totalPages, baseUrl } = Astro.props
const t = useTranslations(lang)
---

<ProfileCard lang={lang} />
<h1 class="sr-only">{t('nav.home')}</h1>
<div class="mx-auto flex max-w-[800px] flex-col gap-6">
  {
    posts.length > 0 ? (
      posts.map((post) => <PostCard lang={lang} post={post} />)
    ) : (
      <div class="py-16 text-center text-[0.95rem] text-ink-3">{t('list.empty')}</div>
    )
  }
  <Pagination lang={lang} currentPage={currentPage} totalPages={totalPages} baseUrl={baseUrl} />
</div>
