---
import '@/styles/PostCard.css'
import Icon from '@/components/Icon.astro'
import { defaultLang, type Lang, localePath, useTranslations } from '@/i18n/ui'
import { mdiCalendarOutline, mdiUpdate } from '@/lib/icons'
import { excerptOf, formatDate, type Post, readMinutes, wordCount } from '@/lib/posts'

interface Props {
  lang?: Lang
  post: Post
}

const { lang = defaultLang, post } = Astro.props
const t = useTranslations(lang)

const title = post.data.title
const date = formatDate(post.data.published)
const words = wordCount(post)
const mins = readMinutes(post)
const excerpt = excerptOf(post)
const category = post.data.category
const tags = post.data.tags
const pinned = post.data.index > 0
const postUrl = localePath(lang, `/posts/${post.id}`)
const categoryUrl = localePath(lang, `/categories/${encodeURIComponent(category)}`)
const tagUrl = (tag: string) => localePath(lang, `/tags/${encodeURIComponent(tag)}`)
---

<article
  class="relative mt-3 rounded-[12px] border border-line-light bg-surface px-6 py-5 shadow-card transition duration-300 hover:-translate-y-0.5 hover:shadow-card-hover max-md:px-4 max-md:py-4"
>
  {pinned && <span class="card-badge card-badge-left">{t('list.pinned')}</span>}
  <a href={categoryUrl} class="card-badge card-badge-right">{category}</a>

  <h2 class="mt-2.5 mb-1.5 font-serif text-[1.3rem] leading-snug font-bold">
    <a href={postUrl} class="text-ink transition hover:text-accent">{title}</a>
  </h2>

  <div class="flex items-center gap-2 text-[0.82rem] text-ink-3">
    <span class="inline-flex items-center gap-1">
      <Icon d={mdiCalendarOutline} class="text-sm" />
      {date}
    </span>
    <span class="text-line">·</span>
    <span>{words}
    {t('post.words')}</span>
    <span class="text-line">·</span>
    <span>{mins}
    {t('post.minutes')}</span>
  </div>

  {excerpt && <p class="mt-1.5 truncate text-[0.92rem] text-ink-2">{excerpt}</p>}

  {
    tags.length > 0 && (
      <div class="mt-2 mb-4 flex flex-wrap gap-2">
        {tags.map((tag) => (
          <a
            href={tagUrl(tag)}
            class="rounded-[4px] bg-paper px-2 py-0.5 text-[0.75rem] text-ink-3 transition hover:bg-surface-hover hover:text-accent"
          >
            #{tag}
          </a>
        ))}
      </div>
    )
  }

  <div class="card-actions">
    <a href={postUrl} class="card-badge card-btn">{t('list.readMore')}</a>
  </div>
  {post.data.updated && <span class="card-badge card-btn-left"><Icon d={mdiUpdate} class="mr-1 text-[11px]" />{formatDate(post.data.updated)}</span>}
</article>

