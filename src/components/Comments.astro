---
import '@/styles/comments.css'
import { siteConfig } from '@/lib/siteConfig'

const commentScript = siteConfig.commentScript
---

{
  commentScript && (
    <section
      class="comment-section is-loading mx-auto mt-10 max-w-[800px]"
      data-comment-script={commentScript}
      aria-label="Comments"
    >
      <div class="comment-skeleton" aria-hidden="true">
        <span />
        <span />
        <span />
      </div>
      <div class="comment-mount" />
    </section>
  )
}

<script>
  import '@/comments/client'
</script>
